# --- LLM ---
LLM_PROVIDER=gemini                 # gemini | claude
GEMINI_API_KEY=
ANTHROPIC_API_KEY=                  # optional, only if LLM_PROVIDER=claude
ANALYST_MODEL=gemini-3.8-flash      # verify current IDs in Google AI Studio
JUDGE_MODEL=gemini-3.8-flash
SCALP_MODEL=
ENABLE_SEARCH=true

# --- Data ---
FRED_API_KEY=                       # optional; falls back to FRED's public CSV endpoint

# --- Budget ---
BUDGET_THB=100
USD_THB=33

# --- Storage ---
ORACLE_DB=data/oracle.db
