# --- LLM ---
LLM_PROVIDER=gemini                 # gemini | claude
GEMINI_API_KEY=
ANTHROPIC_API_KEY=                  # optional, only if LLM_PROVIDER=claude
ANALYST_MODEL=gemini-3.5-flash-lite # default for every role; verify IDs in Google AI Studio
JUDGE_MODEL=gemini-3.5-flash-lite   # (pick pricier models per run in the Arena / Duel)
SCALP_MODEL=gemini-3.5-flash-lite
ENABLE_SEARCH=true

# --- Data ---
FRED_API_KEY=                       # optional; falls back to FRED's public CSV endpoint

# --- Budget ---
BUDGET_THB=100
USD_THB=33
GEMINI_SEARCH_FREE_PER_MONTH=5000   # estimated-actual cost: first N searches/month free
BUDGET_BASIS=tracked                # tracked (list price, conservative) | actual

# --- Web API (Oracle Arena) ---
MOCK_LLM=false                      # true = replay stored shows, no LLM calls (scripts\dev.ps1 sets true)
MOCK_SPEED=1                        # mock delay multiplier (0 = instant)
API_PORT=8000

# --- Storage ---
ORACLE_DB=data/oracle.db

# --- Optional Claude provider (LLM_PROVIDER=claude) ---
CLAUDE_ANALYST_MODEL=claude-opus-5-5
CLAUDE_JUDGE_MODEL=claude-opus-5-5
CLAUDE_SCALP_MODEL=claude-opus-5-5

# --- Tuning ---
ANALYST_THINKING=low                # Gemini thinking_level / Claude effort
JUDGE_THINKING=medium
AGENT_TIMEOUT_S=60
AUTO_SCALP_MAX_RUNS=40
